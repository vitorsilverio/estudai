rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Per-user profile: which exam is active.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Per-exam progress.
    match /users/{uid}/examProgress/{examId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Personal error log (mapa de erros).
    match /users/{uid}/errorLog/{entryId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Redação (essay) photos + corrections. Deliberately restricted to an allowlist of
    // emails — this feature is not automated, and access to it (even just uploading) is
    // meant to stay limited to the people it was built for, not open to any signed-in user.
    match /users/{uid}/essays/{essayId} {
      allow read, write: if request.auth != null && request.auth.uid == uid
        && request.auth.token.email in [
          'vitor.silverio.rodrigues@gmail.com',
          'mariaramos2413@gmail.com'
        ];
    }

    // Study content (exams/subjects/topics/pages/questions/flashcards) is read-only for any
    // signed-in user. It's only ever written by an admin script (Firebase Admin SDK,
    // which bypasses these rules entirely), never by the app itself.
    match /exams/{examId} {
      allow read: if request.auth != null;

      match /{document=**} {
        allow read: if request.auth != null;
      }
    }
  }
}
